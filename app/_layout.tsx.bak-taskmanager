import React, { useEffect, useRef, useState } from "react";
import { Stack } from "expo-router";
import * as SplashScreen from "expo-splash-screen";
import {
  useFonts,
  Montserrat_400Regular,
  Montserrat_600SemiBold,
  Montserrat_700Bold,
  Montserrat_800ExtraBold,
} from "@expo-google-fonts/montserrat";

import { ThemeProvider } from "../src/context/ThemeContext";
import { ToastProvider } from "../src/context/ToastContext";
import { bootApplication } from "../src/core/boot";
import { useLogFeedback } from "../src/feedback";

// Mantiene visible el splash nativo hasta que fuentes + boot() terminen.
SplashScreen.preventAutoHideAsync().catch(() => {
  // No-op: en algunos entornos web/testing la API puede no estar disponible.
});

/**
 * FeedbackBridge — monta useLogFeedback() para que la cola de feedback del
 * motor legado (selectPendingFeedback) llegue a los toasts en toda la app,
 * sin importar en qué grupo de rutas esté el usuario.
 */
function FeedbackBridge() {
  useLogFeedback();
  return null;
}

export default function RootLayout() {
  const [fontsLoaded, fontsError] = useFonts({
    Montserrat_400Regular,
    Montserrat_600SemiBold,
    Montserrat_700Bold,
    Montserrat_800ExtraBold,
  });

  const [bootFinished, setBootFinished] = useState(false);
  const hasBootedRef = useRef(false);

  useEffect(() => {
    // Guarda contra el doble-invoke de efectos en React 18 dev/StrictMode:
    // bootApplication() ya es idempotente internamente, pero evitamos incluso
    // disparar la segunda llamada desde este componente.
    if (hasBootedRef.current) return;
    hasBootedRef.current = true;

    bootApplication()
      .catch((error) => {
        console.error("Fallo al arrancar Dual Tracker desde el layout raíz:", error);
      })
      .finally(() => {
        setBootFinished(true);
      });
  }, []);

  useEffect(() => {
    if ((fontsLoaded || fontsError) && bootFinished) {
      SplashScreen.hideAsync().catch(() => {
        // No-op: ver comentario superior.
      });
    }
  }, [fontsLoaded, fontsError, bootFinished]);

  if (!fontsLoaded && !fontsError) {
    return null;
  }

  return (
    <ThemeProvider>
      <ToastProvider>
        <FeedbackBridge />
        <Stack screenOptions={{ headerShown: false }}>
          <Stack.Screen name="(boot)" />
          <Stack.Screen name="(onboarding)" />
          <Stack.Screen name="(tabs)" />
          <Stack.Screen name="session" />
          <Stack.Screen name="sites" />
          <Stack.Screen name="report" />
          <Stack.Screen name="system" />
          <Stack.Screen name="legal" />
        </Stack>
      </ToastProvider>
    </ThemeProvider>
  );
}
